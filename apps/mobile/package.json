{
  "name": "@healuxa/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "e2e:backends": "scripts/e2e-backends.sh",
    "e2e:seed": "node e2e/seed.mjs",
    "e2e:build:ios": "detox build -c ios.sim.release",
    "e2e:test:ios": "detox test -c ios.sim.release --headless --cleanup"
  },
  "dependencies": {
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "15.1.1",
    "expo": "57.0.28",
    "expo-application": "57.0.3",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.4",
    "expo-device": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.12",
    "expo-local-authentication": "57.0.3",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.26",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "25.9.1",
    "@types/react": "19.2.18",
    "detox": "20.51.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/ios/",
      "/android/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|test-renderer)"
    ]
  }
}
