# Healuxa web — runtime environment (server-side only; nothing here is exposed to the browser).
# The browser never calls backend services directly: Server Components / Server Actions do,
# so there is no client-side API base to configure (only Stripe's hosted fields load in the browser).

# Public origin of this site (canonical URLs, hreflang, sitemap, Stripe return URL). No trailing slash.
SITE_URL=https://healuxa.com

# Production: ONE gateway base; the nginx edge routes /v1/* to the owning service
# (infrastructure/production/gateway/nginx.conf). Include /v1.
API_BASE_URL=http://gateway/v1

# Optional per-service overrides (local dev without the gateway). Each includes /v1.
# IDENTITY_API_URL=http://127.0.0.1:8001/v1
# PROVIDER_API_URL=http://127.0.0.1:8005/v1
# PROFILE_API_URL=http://127.0.0.1:8002/v1
# ASSESSMENT_API_URL=http://127.0.0.1:8003/v1
# APPOINTMENT_API_URL=http://127.0.0.1:8007/v1
# SUBSCRIPTION_API_URL=http://127.0.0.1:8009/v1
# PAYMENT_API_URL=http://127.0.0.1:8010/v1
# CONCIERGE_API_URL=http://127.0.0.1:8021/v1
# NOTIFICATION_API_URL=http://127.0.0.1:8022/v1

# Access tokens are verified locally against identity-service's JWKS (no service secret here).
# Default: <API_BASE_URL without /v1>/.well-known/jwks.json
# IDENTITY_JWKS_URL=http://gateway/.well-known/jwks.json
# Must equal identity-service JWT_ISSUER.
IDENTITY_JWT_ISSUER=https://api.healuxa.com

# Secure (__Host-) cookies. Leave unset in production (defaults to true); set false only for plain-http local runs.
# AUTH_COOKIE_SECURE=false

# Trust X-Forwarded-For from the reverse proxy to forward the client IP to identity-service (sessions, lockouts).
TRUST_PROXY_HEADERS=true

# Extra hosts allowed to invoke Server Actions (comma-separated) when a proxy rewrites Host. Usually empty.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# Public directory/catalog data cache (seconds) and backend request timeout (ms).
PUBLIC_REVALIDATE_SECONDS=60
API_TIMEOUT_MS=8000

# Contact page channels (no contact-form backend exists; the page offers mailto/tel/WhatsApp links).
SUPPORT_EMAIL=concierge@healuxa.com
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Reported by /api/health.
APP_VERSION=

# Container
PORT=3000
