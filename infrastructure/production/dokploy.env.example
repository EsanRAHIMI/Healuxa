# Paste into Dokploy Environment and set every required value. Never commit real values.
# Generate independent hex passwords (64 characters) so DATABASE_URL needs no percent encoding.
# Mongo: separate database users limited to healuxa_profile / healuxa_assessment.
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
TRANSFORMATION_DB_PASSWORD=
PROVIDER_DB_PASSWORD=
APPOINTMENT_DB_PASSWORD=
CONCIERGE_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
SUBSCRIPTION_DB_PASSWORD=
SERVICE_AUTH_CLIENT_SECRET=
PASSWORD_PEPPER=
MFA_ENCRYPTION_KEY=
PROFILE_MONGODB_URI=
ASSESSMENT_MONGODB_URI=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_LIVE_MODE=

SITE_URL=https://healuxa.ae
JWT_ISSUER=https://api.healuxa.ae
# Explicit processor mode; do not substitute fake keys to pass validation.
# PAYMENTS_LIVE_MODE=true requires real live keys; false requires real sandbox keys.
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_TRN=
TAX_CONFIG_REVIEWED=false
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FIXED_MINOR=0
