# Shared by every service. Copy to common.env (never commit real values).
APP_ENV=production
TENANT_DEFAULT=healuxa-dubai
LOG_LEVEL=INFO
NATS_ENABLED=true
# Internal mesh client seeded by identity-service on first start; every service uses the same pair.
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=
# Leave empty unless Traefik ForwardAuth sends X-Healuxa-Edge-Secret (strip X-Healuxa-* at the edge).
HEALUXA_EDGE_SECRET=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
