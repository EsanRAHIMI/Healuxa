# identity-service — copy to identity-service.env.
DATABASE_URL=postgresql+asyncpg://healuxa:<POSTGRES_PASSWORD>@postgres:5432/identity
PASSWORD_PEPPER=
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Healuxa
JWT_ISSUER=https://api.healuxa.ae
# Optional; otherwise keys are generated and stored in the database.
# Omit entirely to use database-managed signing keys (an empty value fails the production guard).
# JWT_PRIVATE_KEY_PEM=
