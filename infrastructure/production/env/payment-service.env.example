# payment-service — copy to payment-service.env.
DATABASE_URL=postgresql+asyncpg://healuxa:<POSTGRES_PASSWORD>@postgres:5432/payment
# Sandbox keys until live payments are approved (live mode also needs PAYMENTS_LIVE_MODE=true).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYMENTS_LIVE_MODE=false
PAYMENT_GATEWAY=stripe
CURRENCY=AED
# Disclosed Healuxa coordination fee (basis points and/or fixed minor units).
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FIXED_MINOR=0
PLATFORM_FEE_LABEL=Healuxa coordination fee
# Invoice seller of record and VAT (requires accountant review; see docs/EXTERNAL_BLOCKERS.md).
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_TRN=
VAT_NAME=VAT
TAX_CONFIG_REVIEWED=false
INVOICE_NUMBER_PREFIX=HLX
MEMBERSHIP_PAYMENTS_ENABLED=false
