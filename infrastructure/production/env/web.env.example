# web — copy to web.env. API_BASE_URL is set by docker-compose (internal gateway).
SITE_URL=https://healuxa.ae
# Must match identity-service JWT_ISSUER (tokens are verified against identity's JWKS).
IDENTITY_JWT_ISSUER=https://api.healuxa.ae
# Traefik sits in front: trust its X-Forwarded-* headers.
TRUST_PROXY_HEADERS=true
SERVER_ACTIONS_ALLOWED_ORIGINS=healuxa.ae,www.healuxa.ae
PUBLIC_REVALIDATE_SECONDS=300
API_TIMEOUT_MS=8000
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
APP_VERSION=
