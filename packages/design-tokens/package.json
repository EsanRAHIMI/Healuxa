{
  "name": "@healuxa/design-tokens",
  "version": "0.1.0",
  "description": "Healuxa design tokens — colour (light/dark), typography, spacing, radii, elevation, motion — as TypeScript, CSS variables, a Tailwind v4 theme and a Tailwind/NativeWind preset.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./tokens.css": "./css/tokens.css",
    "./theme.css": "./css/theme.css"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build-css.ts",
    "check:css": "node --experimental-strip-types scripts/build-css.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
