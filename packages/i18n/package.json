{
  "name": "@healuxa/i18n",
  "version": "0.1.0",
  "description": "Healuxa message catalogs (en, ar, fa launch; fr, de scaffolding), RTL metadata, ICU message + Intl formatting helpers and the professional-review manifest.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/*.json": "./messages/*.json",
    "./manifest.json": "./manifest.json"
  },
  "scripts": {
    "manifest": "node scripts/manifest.mjs",
    "check:manifest": "node scripts/manifest.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "intl-messageformat": "12.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
