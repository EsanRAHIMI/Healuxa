# Healuxa AI Orchestrator — customer assistant (ACL to the LLM provider). Copy to .env per environment.

# ── Shared (py-common ServiceSettings) ───────────────────────────────────────
APP_ENV=development
SERVICE_NAME=ai-orchestrator
LOG_LEVEL=INFO
TENANT_DEFAULT=healuxa-dubai

# ── PostgreSQL (ai logical DB: ai_sessions, ai_turns) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/ai
# Tests only:
# DATABASE_URL=postgresql+asyncpg://healuxa:dev@127.0.0.1:5432/ai_e2e_test

# ── Identity introspection (Bearer fallback when edge headers are absent) ─────
IDENTITY_INTROSPECT_URL=http://localhost:8001/v1/auth/introspect
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=dev-service-secret-change-me
# Only set when the edge sends X-Healuxa-Edge-Secret; otherwise leave empty.
HEALUXA_EDGE_SECRET=

# ── LLM provider ──────────────────────────────────────────────────────────────
# anthropic (production) | fake (deterministic double for tests/local E2E; refused when APP_ENV=production|staging)
LLM_PROVIDER=anthropic
# Without a key the service still boots; message endpoints answer 503 service_unavailable and the UI says so.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT_SECONDS=45
ANTHROPIC_MAX_RETRIES=1
# Server-side refusal fallback (beta header server-side-fallback-2026-07-01, fallbacks="default").
ANTHROPIC_REFUSAL_FALLBACK=true

# ── Verified platform data (tools run with the caller's own token). Include /v1. ─
PROVIDER_API_URL=http://localhost:8005/v1
APPOINTMENT_API_URL=http://localhost:8007/v1
TRANSFORMATION_API_URL=http://localhost:8000/v1
CONCIERGE_API_URL=http://localhost:8021/v1
TOOL_TIMEOUT_SECONDS=6

# ── Guardrails ────────────────────────────────────────────────────────────────
MAX_MESSAGE_CHARS=2000
MAX_TURNS_PER_SESSION=80
HISTORY_TURNS=16
MAX_TOOL_ITERATIONS=6
MAX_TOOL_CALLS_PER_TURN=12
TURN_TIMEOUT_SECONDS=90
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=150
EMERGENCY_NUMBER=998

# ── NATS (auth.user_deleted erasure consumer) ─────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_ENABLED=false
