# Healuxa Appointment Service — copy to .env and adjust per environment.
APP_ENV=development
SERVICE_NAME=appointment-service
LOG_LEVEL=INFO
TENANT_DEFAULT=healuxa-dubai
PUBLIC_TENANT=healuxa-dubai

DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/appointment
# Tests only:
# DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/appointment_test

# Caller authentication (bearer introspection) and this service's own service token.
IDENTITY_INTROSPECT_URL=http://localhost:8001/v1/auth/introspect
IDENTITY_SERVICE_TOKEN_URL=http://localhost:8001/v1/auth/service-token
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=dev-service-secret-change-me

# Availability source of truth. Unreachable => 503, never invented slots.
PROVIDER_SERVICE_URL=http://localhost:8005
PROVIDER_TIMEOUT_SECONDS=3.0

# Shared secret the edge (Traefik ForwardAuth) sends to prove injected identity headers. Leave empty
# unless the edge is configured; services then authenticate bearer tokens themselves.
HEALUXA_EDGE_SECRET=

NATS_URL=nats://localhost:4222
NATS_ENABLED=false

# Booking policy
HOLD_TTL_MINUTES=10
MAX_ACTIVE_HOLDS_PER_CUSTOMER=3
SLOT_INTERVAL_MINUTES=15
MIN_LEAD_MINUTES=60
MAX_HORIZON_DAYS=90
MAX_SLOT_RANGE_DAYS=31
CUSTOMER_CANCEL_CUTOFF_MINUTES=120
CHECK_IN_OPENS_MINUTES=60
NO_SHOW_GRACE_MINUTES=15
REMINDER_OFFSETS_MINUTES=[1440,120]
# Stage D hook: priced bookings need an authorized/captured payment before confirmation.
PAYMENT_REQUIRED=false

SWEEPER_ENABLED=true
SWEEPER_INTERVAL_SECONDS=30
