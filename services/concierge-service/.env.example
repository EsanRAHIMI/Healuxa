# Healuxa Concierge Service — copy to .env and adjust per environment.
# APP_ENV must be `production` or `staging` on servers: the service then refuses to start while any
# *_SECRET setting is empty or still a development default.
APP_ENV=development
SERVICE_NAME=concierge-service
LOG_LEVEL=INFO
TENANT_DEFAULT=healuxa-dubai

DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/concierge
# Tests only:
# DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/concierge_test

IDENTITY_INTROSPECT_URL=http://localhost:8001/v1/auth/introspect
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=dev-service-secret-change-me

# Shared secret the edge (Traefik ForwardAuth) sends to prove injected identity headers. Leave empty
# unless the edge is configured; services then authenticate bearer tokens themselves.
HEALUXA_EDGE_SECRET=

NATS_URL=nats://localhost:4222
# true starts the outbox relay (concierge.* events → JetStream).
NATS_ENABLED=false

# Minutes a coordinator has to triage, claim or reply before the case's first-response SLA is breached.
FIRST_RESPONSE_SLA_MINUTES=240
