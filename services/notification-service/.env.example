# Healuxa Notification Service — copy to .env and adjust per environment.
# APP_ENV must be `production` or `staging` on servers: the service then refuses to start while any
# *_SECRET setting is empty or still a development default.
APP_ENV=development
SERVICE_NAME=notification-service
LOG_LEVEL=INFO
TENANT_DEFAULT=healuxa-dubai

DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/notification
# Tests only:
# DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/notification_test

IDENTITY_INTROSPECT_URL=http://localhost:8001/v1/auth/introspect
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=dev-service-secret-change-me

# Shared secret the edge (Traefik ForwardAuth) sends to prove injected identity headers. Leave empty
# unless the edge is configured; services then authenticate bearer tokens themselves.
HEALUXA_EDGE_SECRET=

NATS_URL=nats://localhost:4222
# true starts the durable consumers (concierge.*, catalog.*, appointment.* → notifications).
NATS_ENABLED=false

DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Dubai

DELIVERY_WORKER_ENABLED=true
DELIVERY_POLL_SECONDS=2
DELIVERY_BATCH_SIZE=50
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_BASE_SECONDS=30
DELIVERY_BACKOFF_MAX_SECONDS=3600

# Channel drivers: log (default; records attempts, sends nothing) | disabled | smtp (email only).
EMAIL_DRIVER=log
SMS_DRIVER=log
WHATSAPP_DRIVER=log
PUSH_DRIVER=log
# Real drivers refuse to start unless this is true. Keep false in development and tests.
ALLOW_REAL_DELIVERY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Healuxa <no-reply@healuxa.com>
SMTP_STARTTLS=true
