# Healuxa Payment Service — copy to .env and adjust per environment. SANDBOX ONLY until the merchant
# account, accountant review and owner approval in docs/EXTERNAL_BLOCKERS.md are done.
APP_ENV=development
SERVICE_NAME=payment-service
LOG_LEVEL=INFO
TENANT_DEFAULT=healuxa-dubai

DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/payment
# Tests only:
# DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/payment_test

IDENTITY_INTROSPECT_URL=http://localhost:8001/v1/auth/introspect
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=dev-service-secret-change-me
HEALUXA_EDGE_SECRET=

NATS_URL=nats://localhost:4222
NATS_ENABLED=false

# Processor. `fake` = deterministic in-process processor (development/test only; refused elsewhere).
PAYMENT_GATEWAY=fake
# Stripe sandbox: sk_test_/pk_test_ keys and the endpoint's whsec_ signing secret.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
WEBHOOK_TOLERANCE_SECONDS=300
# Live mode is refused unless PAYMENTS_LIVE_MODE=true AND an sk_live_ key AND APP_ENV=production.
PAYMENTS_LIVE_MODE=false
CURRENCY=AED

# Pricing and tax — PENDING ACCOUNTANT REVIEW. Basis points (500 = 5%).
PLATFORM_FEE_BPS=500
PLATFORM_FEE_FIXED_MINOR=0
PLATFORM_FEE_LABEL=Healuxa coordination fee
VAT_NAME=VAT
VAT_RATES_BPS={"professional_service":500,"facility_service":500,"platform_fee":500,"concierge_service":500,"membership":500,"third_party":500}
TAX_CONFIG_REVIEWED=false
QUOTE_TTL_SECONDS=1800
APPOINTMENT_CAPTURE_METHOD=manual

# Cancellation refund policy hook.
REFUND_FULL_WINDOW_HOURS=24
REFUND_PARTIAL_PERCENT=50

# Invoice / credit note seller details (placeholders until the legal entity and TRN exist).
INVOICE_NUMBER_PREFIX=HLX
SELLER_LEGAL_NAME=Healuxa (legal entity name pending)
SELLER_TRN=TRN-PENDING
SELLER_ADDRESS=Dubai, United Arab Emirates (registered address pending)

# Integrations.
PROVIDER_SERVICE_URL=http://localhost:8005
MEMBERSHIP_PAYMENTS_ENABLED=false
