# Healuxa Provider Service — copy to .env and adjust per environment.
APP_ENV=development
SERVICE_NAME=provider-service
LOG_LEVEL=INFO
TENANT_DEFAULT=healuxa-dubai

DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/provider
# Tests only:
# DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/provider_test

IDENTITY_INTROSPECT_URL=http://localhost:8001/v1/auth/introspect
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=dev-service-secret-change-me

# Shared secret the edge (Traefik ForwardAuth) sends to prove injected identity headers. Leave empty
# unless the edge is configured; services then authenticate bearer tokens themselves.
HEALUXA_EDGE_SECRET=

NATS_URL=nats://localhost:4222
NATS_ENABLED=false

# Currencies offerings may be priced in (launch: AED only).
SUPPORTED_CURRENCIES=["AED"]
