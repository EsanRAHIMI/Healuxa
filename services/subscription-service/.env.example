# Healuxa Subscription Service — copy to .env. Memberships stay disabled (404) until commercial approval.
APP_ENV=development
SERVICE_NAME=subscription-service
LOG_LEVEL=INFO
TENANT_DEFAULT=healuxa-dubai
DATABASE_URL=postgresql+asyncpg://healuxa:dev@localhost:5432/subscription
IDENTITY_INTROSPECT_URL=http://localhost:8001/v1/auth/introspect
SERVICE_AUTH_CLIENT_ID=healuxa-internal
SERVICE_AUTH_CLIENT_SECRET=dev-service-secret-change-me
HEALUXA_EDGE_SECRET=
NATS_URL=nats://localhost:4222
NATS_ENABLED=false
MEMBERSHIPS_ENABLED=false
CURRENCY=AED
